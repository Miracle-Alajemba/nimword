# Nimiq Configuration
NIMIQ_TREASURY_ADDRESS=NQ...your treasury NIM address here
NIMIQ_TREASURY_PRIVATE_KEY=your_nimiq_private_key_here
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# Game Configuration
JOIN_PAYMENT_NIM=1
JOIN_PAYMENT_DISPLAY=1 NIM
DAILY_REWARD_NIM=0.1

# Server
PORT=4000
DATABASE_URL=postgresql://...
REDIS_URL=redis://...

# Admin — required to reach /api/debug/* and the daily-history reset endpoint.
# Leave unset in production: the guard fails closed, so those routes stay 403.
ADMIN_TOKEN=
